## DHT11_3Pin_Module
#
DEF DHT11_3Pin_Module U 0 40 Y Y 1 F N
F0 "U" 0 200 50 H V C CNN
F1 "DHT11_3Pin_Module" 0 101 50 H V C CNN
DRAW
S -200 -250 200 50 0 1 10 f
T 0 -100 0 35 0 0 0 "DHT11" Normal 0 C C
X VCC 1 -300 0 100 R 40 40 1 1 W
X DATA 2 300 -100 100 L 40 40 1 1 B
X GND 3 -300 -200 100 R 40 40 1 1 W
ENDDRAW
ENDDEF
