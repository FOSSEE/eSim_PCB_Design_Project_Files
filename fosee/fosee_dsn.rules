
(rules PCB fosee_dsn.dsn
  (snapAngle 
    fortyfive_degree
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_800:300_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:300_um" "Via[0-1]_800:300_um" default
  )
  (viaRule
    default "Via[0-1]_800:300_um"
  )
  (viaRule
    default "Via[0-1]_800:300_um"
  )
  (class default
    "Net-(R8-Pad1)" "Net-(Q1-Pad2)" "Net-(R7-Pad1)" "Net-(D4-Pad1)" "Net-(R6-Pad1)" "Net-(D3-Pad1)" "Net-(R5-Pad1)" "Net-(D2-Pad1)"
    "Net-(J3-Pad3)" +3V3 "Net-(J3-Pad4)" VCC "Net-(J4-Pad5)" "Net-(J2-Pad2)" GND "Net-(C2-Pad1)"
    "Net-(C4-Pad1)" "unconnected-(U3-Pad1)" "Net-(C3-Pad1)" "Net-(C1-Pad1)" "unconnected-(U3-Pad12)" "unconnected-(U3-Pad13)" "unconnected-(U3-Pad14)" "Net-(J4-Pad1)"
    "Net-(J4-Pad3)" "unconnected-(U3-Pad19)" "Net-(C6-Pad1)" "unconnected-(U3-Pad22)" "unconnected-(U3-Pad24)" "unconnected-(U3-Pad25)" "unconnected-(U3-Pad26)" "Net-(J5-Pad04)"
    "Net-(J5-Pad03)" "Net-(SENS-1-PadP$2)" "Net-(D5-Pad1)" "Net-(D1-Pad1)" "unconnected-(J3-Pad1)" "unconnected-(J2-Pad1)" "unconnected-(J1-Pad2)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)