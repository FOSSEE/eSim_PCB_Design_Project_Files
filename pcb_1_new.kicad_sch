    (property "MF" "Espressif Systems" (id 4) (at 67.31 139.7 0)
      (effects (font (size 1.27 1.27)) (justify bottom) hide)
    )
    (property "Description" "\n                        \n                            The ESP32-C3-DEVKITC-02 Evaluation Board from Espressif Systems is a development platform for wireless applications, offering 802.11 b/g/n Wi-Fi and Bluetooth (BLE) connectivity at 2.4GHz. Powered by the ESP32-C3-WROOM-02 module, it features a 32-bit RISC-V single-core processor running at 160MHz, with 4MB flash, 400KB SRAM, and 384KB ROM. The board provides 22 GPIO pins and supports a range of interfaces, including 3 x SPI, 2 x UART, I2C, I2S, RMT, LED PWM, USB Serial/JTAG, GDMA, TWAI, and a 12-bit ADC. Its PCB antenna ensures reliable wireless performance, while the USB interface allows for easy programming and debugging.\n                        \n" (id 5) (at 67.31 139.7 0)
      (effects (font (size 1.27 1.27)) (justify bottom) hide)
    )
